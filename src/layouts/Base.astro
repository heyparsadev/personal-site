---
import { ClientRouter } from 'astro:transitions';
import Island from '../components/Island.astro';
import { normalizePath } from '../lib/page-ctx';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** For pages that must not be indexed (the 404): no canonical or og:url, and robots noindex. */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
// Same form as the internal links and the site map: no trailing slash, except the root "/".
const canonical = new URL(normalizePath(Astro.url.pathname), Astro.site);
// The link preview every page shares: public/og.png, rendered from scripts/og/card.html (npm run og).
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Parsa Kharazmian. Founder & CEO of Sibkade. Now building Barayand." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfbfd" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        // Light unless the visitor chose dark (mirrors resolveTheme/THEME_COLOR in src/scripts/theme.ts).
        const color = (t) => (t === 'dark' ? '#000000' : '#fbfbfd');
        let t = null;
        try { t = localStorage.getItem('heyparsa-theme'); } catch (e) {}
        t = t === 'dark' ? 'dark' : 'light';
        root.dataset.theme = t;
        root.style.colorScheme = t;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', color(t));
        root.classList.add('js');
        if (window.__hpBoot) return;
        window.__hpBoot = true;
        setTimeout(() => {
          const r = document.documentElement;
          if (!r.classList.contains('island-ready')) r.classList.add('island-failed');
        }, 4000);
        document.addEventListener('astro:before-swap', (e) => {
          const from = document.documentElement, to = e.newDocument.documentElement;
          to.dataset.theme = from.dataset.theme;
          to.style.colorScheme = from.style.colorScheme;
          e.newDocument.querySelector('meta[name="theme-color"]')?.setAttribute('content', color(from.dataset.theme));
          for (const c of ['js', 'island-ready', 'island-failed']) if (from.classList.contains(c)) to.classList.add(c);
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Island />
    <main id="content">
      <slot />
    </main>
    <slot name="overlay" />
    <script>
      import '../scripts/sheet';
      import '../scripts/page-transition';
    </script>
  </body>
</html>
